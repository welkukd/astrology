{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm ci",
  "framework": "nextjs",
  "regions": ["iad1"],
  "outputDirectory": ".next",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://astrology-api.up.railway.app/api/v1/:path*"
    },
    {
      "source": "/api/health",
      "destination": "https://astrology-api.up.railway.app/health"
    }
  ]
}